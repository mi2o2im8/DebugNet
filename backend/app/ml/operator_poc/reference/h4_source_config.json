{
  "engine": {
    "name": "H4 Participation Early Warning Engine",
    "version": "MVP_v1",
    "purpose": "가입 후 실제 참여 행동을 기반으로 참여저하 회원을 조기에 탐지하고 운영자 개입을 지원"
  },
  "data_roles": {
    "official_survey": {
      "role": "Research Evidence",
      "production_score": false,
      "reason": "참여감소 Target의 연도별 Drift와 코로나 외부충격, 서비스 모집단 내 양성표본 부족으로 안정적 개인 예측모델로 사용하지 않음"
    },
    "qualitative_crawl": {
      "role": "Explainability / Intervention",
      "production_score": false,
      "usage": "Risk Reason 후보와 운영자 Intervention 설계"
    },
    "service_log": {
      "role": "Primary Detection Data",
      "production_score": true
    }
  },
  "behavior_features": [
    "이전4주_참석률",
    "최근4주_참석률",
    "참석률_변화폭",
    "최근4주_취소율",
    "최근4주_노쇼율",
    "연속미참여횟수",
    "연속노쇼횟수",
    "희망빈도대비_실제참여",
    "마지막참석후_미참여기회"
  ],
  "risk_dimensions": {
    "Risk_Trend": "최근 참석률 및 참석률 하락",
    "Risk_NoShow": "노쇼율 및 연속 노쇼",
    "Risk_Cancel": "최근 반복 취소",
    "Risk_EngagementGap": "희망 활동빈도 대비 실제 참여 부족",
    "Risk_Inactivity": "마지막 참석 이후 참여 가능한 활동 미참여"
  },
  "risk_aggregation": {
    "method": "Dominant + Breadth",
    "formula": "0.70 * Max(Risk Dimensions) + 0.30 * Mean(Risk Dimensions)",
    "dominant_weight": 0.7,
    "breadth_weight": 0.3,
    "interpretation": "Risk Severity Index",
    "probability": false
  },
  "thresholds": {
    "normal": {
      "min": 0,
      "max_exclusive": 30
    },
    "attention": {
      "min": 30,
      "max_exclusive": 55
    },
    "manage": {
      "min": 55,
      "max_exclusive": 80
    },
    "high": {
      "min": 80,
      "max": 100
    }
  },
  "grade_labels": {
    "normal": "정상",
    "attention": "관찰",
    "manage": "관리 필요",
    "high": "고위험"
  },
  "reason_policy": {
    "behavior_log_can_confirm_reason": false,
    "reason_candidate_only": true,
    "confirmation_required": true,
    "qualitative_frequency_as_weight": false
  },
  "recovery": {
    "separate_positive_signal": true,
    "subtract_from_risk_score": false,
    "description": "참여가 회복된 회원은 위험점수를 강제로 차감하지 않고 별도의 Recovery Signal로 표시"
  },
  "important_limitations": [
    "Risk Score는 이탈확률이 아니며 MVP 운영 우선순위 지수이다.",
    "70:30 Aggregation은 실제 이탈 라벨로 학습된 가중치가 아니다.",
    "30/55/80 Threshold 역시 Synthetic Scenario 기반 MVP Rule이다.",
    "향후 실제 서비스 로그가 축적되면 향후 4주 참여감소/이탈 등을 Target으로 가중치와 Threshold를 재검증해야 한다.",
    "not_eligible 일정은 불참으로 계산하지 않는다."
  ]
}