+            ) : errorMessage ? (
+
+                <p className="my-apps-message">
+                    신청 현황을 불러오지 못했습니다.
+                    <br />
+                    {errorMessage}
+                </p>
+
+            ) : activeTab === "club" ? (
+
+                renderClubList()
+
+            ) : (
+
+                renderGuestList()
+
+            )}
+
+
+            {/* ⭐ 공통 하단 네비게이션 */}
+            <BottomNav />
+
+        </div>
+    );
+}
+
+
+export default MyApplications;
