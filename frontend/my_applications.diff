+}
+
+/* 참여 완료 (끝난 경기) */
+.my-apps-status.finished {
+    background: #eaf1fd;
+
+    color: #3f6fd1;
+}
+
+/* 거절 */
+.my-apps-status.rejected {
+    background: #fdecec;
+
+    color: #d14343;
+}
+
+/* 취소 / 탈퇴 / 마감 */
+.my-apps-status.muted {
+    background: #f1f3f3;
+
+    color: #8a9a9a;
+}
+
+
+/* ⭐ 게스트 신청 취소 버튼 (카드 하단) */
+.my-apps-cancel {
+    width: 100%;
+
+    padding: 10px 0;
+
+    border: none;
+    border-top: 1px solid #edf0f2;
+
+    background: #fafbfb;
+
+    font-family: inherit;
+    font-size: 13px;
+
+    color: #d14343;
