+}
+
+.club-risk-empty p {
+    margin: 0;
+    font-size: 10px;
+    line-height: 1.5;
+}
+
+.club-risk-disclaimer {
+    margin: 0;
+    color: #8995a7;
+    font-size: 9px;
+    line-height: 1.5;
+    text-align: center;
+}
+
+@media (max-width: 380px) {
+    .club-risk-page {
+        padding-right: 14px;
+        padding-left: 14px;
+    }
+
+    .club-risk-intro {
+        align-items: flex-start;
+    }
+
+    .club-risk-result-row {
+        flex-wrap: wrap;
+    }
+
+    .club-risk-result-row select {
+        flex: 1 0 100%;
+        width: 100%;
+    }
+}
diff --git a/frontend/src/pages/ClubMembers/ClubParticipationRisk.jsx b/frontend/src/pages/ClubMembers/ClubParticipationRisk.jsx
