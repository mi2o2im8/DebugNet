+                if item.management_priority is not None
+                else 99,
+                -(item.risk_score or 0),
+                item.nickname,
+            )
+        )
+
+        return ClubParticipationRiskResponse(
+            risks=risks,
+            total=len(risks),
+            analyzed_count=sum(
+                item.analysis_status == "analyzed"
+                for item in risks
+            ),
+            insufficient_data_count=sum(
+                item.analysis_status == "insufficient_data"
+                for item in risks
+            ),
+            observe_count=sum(
